{% extends 'base.html.twig' %}

{% block title %}Trip List{% endblock %}

{% block body %}

<div class="trip">
    <ul>
        {% for trip in trips %}
            <li>
                <a href="{{ path('trip_read', { id: trip.id }) }}" class="trip-link">
                    <div class="image-wrapper">
                        <img src="{{ trip.image }}" alt="trip image" class="trip-image">
                        <div class="destination-overlay">{{ trip.destination }}</div>
                    </div>
                </a>
            </li>
        {% endfor %}
    </ul>
</div>



