{% extends 'base.html.twig' %}

{% block title %}
    {{ trip.title }}
{% endblock %}

{% block body %}
<div class="tripDetail">
    <header class="tripHeader">
        {% if trip.image %}
            <img src="{{ trip.image }}" alt="{{ trip.title }}" class="tripMainImage">
        {% endif %}
        <h1>{{ trip.title }}</h1>
        <div class="tripHeaderDescription">
        <div class="dateTitle">
        <h2>{{ trip.destination }}</h2>
        <p>{{ trip.startDate|date('d/m/Y') }}</p> 
        <p>{{ trip.endDate|date('d/m/Y') }}</p>
        </div>
        <div class="descriptionTitle">
        {{ trip.description }}  
        </div>
        </div> 
    </header>

    <section class="tripStops">
        <h3>Itinerary</h3>
        {% if trip.stop is not empty %}
            <div class="stopsList">
                {% for stop in trip.stop %}
                    <article class="stopCard {% if loop.index is odd %}left{% else %}right{% endif %}">
                        {% if stop.image %}
                            <img src="{{ stop.image }}" alt="{{ stop.title }}" class="stopImage">
                        {% endif %}
                        <div class="stopContent">
                            <h4>{{ stop.title }}</h4>
                            <p>{{ stop.date|date('d/m/Y') }}</p>
                            <p>📍 {{ stop.location }}</p>
                            <p>{{ stop.content }}</p>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <p>No stops have been added to this trip yet.</p>
        {% endif %}
        {% if app.user and trip.user and app.user.id == trip.user.id %}
<a href="{{ path('stop', {'id': trip.id}) }}" class="buttonAddStop">Add a stop to this trip</a>
{% endif %}
    </section>

    <footer class="tripAuthor">
    <h3>Written by</h3>
    <div class="authorInfo">
    {% if trip.user and trip.user.picture %}
    <img src="{{ trip.user.picture }}" alt="{{ trip.user.username }}" class="authorImage">
    {% endif %}
    <p>{{ trip.user }}</p>
    </div>
    </footer>
</div>
{% endblock %}
