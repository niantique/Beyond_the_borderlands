{% extends 'base.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}

<div class="user">
<ul>
{% for user in users %}
<li>
<h1>{{ user.username}} </h1>
<p>{{ user.roles|join(', ') }}</p>
<h2>{{ user.email }}</h2>
<img src="{{ user.picture }}" alt="user picture">
<p>{{ user.isVerified ? 'Verified' : 'Not verified' }}</p>
</li>
{% endfor %}
</ul>
</div>

{% endblock %}
